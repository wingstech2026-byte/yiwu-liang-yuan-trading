# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where inquiries and uploaded reference files are stored (must be a persistent, writable path on your host).
INQUIRY_DATA_DIR=./data/inquiries

# Analytics: leave empty until you have real IDs. Scripts load only when set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Crisp live chat: your Website ID from app.crisp.chat -> Settings -> Website Settings -> Setup instructions.
# Leave empty to disable the chat widget.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Search Console verification token (content of the google-site-verification meta tag). Optional.
NEXT_PUBLIC_GSC_VERIFICATION=
